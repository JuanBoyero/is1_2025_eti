<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Registrar Profesor</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-2xl">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Registrar Nuevo Profesor</h1>
        
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            {{errorMessage}}
        </div>
        {{/errorMessage}}
        
        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            {{successMessage}}
        </div>
        {{/successMessage}}
        
        <form action="/professor/new" method="post" class="space-y-4">
            <div>
                <label for="name" class="block text-gray-700 font-semibold mb-2">
                    Nombre de Usuario <span class="text-red-500">*</span>
                </label>
                <input type="text" id="name" name="name" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
            </div>
            
            <div>
                <label for="password" class="block text-gray-700 font-semibold mb-2">
                    Contraseña <span class="text-red-500">*</span>
                </label>
                <input type="password" id="password" name="password" required minlength="6"
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                <small class="text-gray-600">Mínimo 6 caracteres</small>
            </div>
            
            <div>
                <label for="real_name" class="block text-gray-700 font-semibold mb-2">
                    Nombre Real <span class="text-red-500">*</span>
                </label>
                <input type="text" id="real_name" name="real_name" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
            </div>
            
            <div>
                <label for="surname" class="block text-gray-700 font-semibold mb-2">
                    Apellido <span class="text-red-500">*</span>
                </label>
                <input type="text" id="surname" name="surname" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
            </div>
            
            <div>
                <label for="dni" class="block text-gray-700 font-semibold mb-2">
                    DNI <span class="text-red-500">*</span>
                </label>
                <input type="text" id="dni" name="dni" pattern="[0-9]{7,8}" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                <small class="text-gray-600">Ingrese 7 u 8 dígitos</small>
            </div>
            
            <div class="flex gap-4 mt-6">
                <button type="submit" 
                        class="flex-1 bg-purple-600 text-white py-2 px-4 rounded-md hover:bg-purple-700 transition duration-300">
                    Guardar
                </button>
                <a href="/dashboard" 
                   class="flex-1 bg-gray-600 text-white py-2 px-4 rounded-md hover:bg-gray-700 transition duration-300 text-center">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</body>
</html>