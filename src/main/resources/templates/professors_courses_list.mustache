<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profesores con Materias - SisInfo</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">
    <div class="max-w-5xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Profesores y sus Materias</h1>
        <p class="text-xl text-gray-600 mb-8">Listado de profesores con las materias que dictan</p>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <div class="bg-white rounded-lg shadow overflow-hidden mb-8">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Profesor</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Materias</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {{#professors}}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{name}} {{surname}}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{courses}}</td>
                    </tr>
                    {{/professors}}
                    {{^professors}}
                    <tr>
                        <td colspan="2" class="px-6 py-4 text-center text-sm text-gray-500">No hay profesores registrados.</td>
                    </tr>
                    {{/professors}}
                </tbody>
            </table>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/admin/dashboard" class="bg-red-600 text-white py-3 px-8 rounded-md hover:bg-red-700 transition text-center font-medium">Volvamos al dashbord</a>
            <a href="/professor/create" class="bg-purple-600 text-white py-3 px-8 rounded-md hover:bg-purple-700 transition text-center font-medium">Agregar profesores</a>
            <a href="/coursed/create" class="bg-yellow-600 text-white py-3 px-8 rounded-md hover:bg-yellow-700 transition text-center font-medium">Agregar materias</a>
        </div>
    </div>
</body>
</html>
