<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración - SisInfo</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">
    <div class="max-w-5xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Panel de Administración</h1>
        <p class="text-xl text-gray-600 mb-8">Bienvenido, <span class="font-semibold text-blue-600">{{username}}</span> 🛠️</p>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
            <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-500">
                <p class="text-sm text-gray-500 uppercase font-semibold">Usuarios</p>
                <p class="text-3xl font-bold text-blue-600">{{totalUsers}}</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-green-500">
                <p class="text-sm text-gray-500 uppercase font-semibold">Profesores</p>
                <p class="text-3xl font-bold text-green-600">{{totalProfessors}}</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-purple-500">
                <p class="text-sm text-gray-500 uppercase font-semibold">Alumnos</p>
                <p class="text-3xl font-bold text-purple-600">{{totalStudents}}</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-yellow-500">
                <p class="text-sm text-gray-500 uppercase font-semibold">Materias</p>
                <p class="text-3xl font-bold text-yellow-600">{{totalCourses}}</p>
            </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-md mb-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Gestión del Sistema</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <a href="/admin/users" class="block p-4 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 transition">
                    <h3 class="font-semibold text-blue-700">Gestionar Usuarios</h3>
                    <p class="text-sm text-gray-600">Administrar cuentas del sistema</p>
                </a>
                <a href="/professor/create" class="block p-4 bg-purple-50 border border-purple-200 rounded-lg hover:bg-purple-100 transition">
                    <h3 class="font-semibold text-purple-700">Registrar Profesor</h3>
                    <p class="text-sm text-gray-600">Dar de alta un nuevo profesor</p>
                </a>
                <a href="/admin/courses" class="block p-4 bg-yellow-50 border border-yellow-200 rounded-lg hover:bg-yellow-100 transition">
                    <h3 class="font-semibold text-yellow-700">Gestionar Materias</h3>
                    <p class="text-sm text-gray-600">Administrar materias del sistema</p>
                </a>
                <a href="/user/new" class="block p-4 bg-green-50 border border-green-200 rounded-lg hover:bg-green-100 transition">
                    <h3 class="font-semibold text-green-700">Crear Usuario</h3>
                    <p class="text-sm text-gray-600">Registrar una cuenta nueva</p>
                </a>
            </div>
        </div>

        <div class="text-center">
            <a href="/logout" class="inline-block bg-red-600 text-white py-2 px-6 rounded-md hover:bg-red-700 transition">Cerrar Sesión</a>
        </div>
    </div>
</body>
</html>
