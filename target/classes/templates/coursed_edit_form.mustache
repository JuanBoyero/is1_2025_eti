<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Materia - SisInfo</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-2xl">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Editar Materia</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        {{#course}}
        <form action="/admin/courses/{{id}}/edit" method="post" class="space-y-4">
            <div>
                <label for="name" class="block text-gray-700 font-semibold mb-2">
                    NOMBRE DE LA MATERIA: <span class="text-red-500">*</span>
                </label>
                <input type="text" id="name" name="name" value="{{name}}" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500"
                       placeholder="Ej: Ingeniería de Software I">
            </div>

            <div>
                <label for="code" class="block text-gray-700 font-semibold mb-2">
                    CÓDIGO: <span class="text-red-500">*</span>
                </label>
                <input type="text" id="code" name="code" value="{{code}}" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500"
                       placeholder="Ej: IS1">
                <small class="text-gray-600">Código identificador único de la materia.</small>
            </div>

            <div>
                <label for="year" class="block text-gray-700 font-semibold mb-2">
                    AÑO/NIVEL: <span class="text-red-500">*</span>
                </label>
                <select id="year" name="year" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500">
                    <option value="" disabled>Seleccione un año/nivel</option>
                    <option value="1" {{#selectedYear1}}selected{{/selectedYear1}}>1er Año</option>
                    <option value="2" {{#selectedYear2}}selected{{/selectedYear2}}>2do Año</option>
                    <option value="3" {{#selectedYear3}}selected{{/selectedYear3}}>3er Año</option>
                    <option value="4" {{#selectedYear4}}selected{{/selectedYear4}}>4to Año</option>
                    <option value="5" {{#selectedYear5}}selected{{/selectedYear5}}>5to Año</option>
                </select>
            </div>

            <div>
                <label for="courseLoad" class="block text-gray-700 font-semibold mb-2">
                    CARGA HORARIA: <span class="text-red-500">*</span>
                </label>
                <input type="number" id="courseLoad" name="courseLoad" value="{{courseLoad}}" required min="1" step="1"
                       pattern="[0-9]*"
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500"
                       placeholder="Ej: 4">
                <small class="text-gray-600">Ingrese la carga horaria cuatrimestral en horas (solo números).</small>
            </div>

            <div class="flex gap-4 mt-6">
                <button type="submit"
                        class="flex-1 bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition duration-300">
                    Guardar Cambios
                </button>
                <a href="/admin/courses"
                   class="flex-1 bg-gray-600 text-white py-2 px-4 rounded-md hover:bg-gray-700 transition duration-300 text-center">
                    Cancelar
                </a>
            </div>
        </form>
        {{/course}}
    </div>
</body>
</html>
