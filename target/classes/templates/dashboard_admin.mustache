<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel de Administración - SisInfo</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-gray-900 via-gray-800 to-blue-900 min-h-screen p-6 relative">
    <div class="max-w-3xl mx-auto">
        <div class="bg-white/10 backdrop-blur-md rounded-2xl shadow-2xl p-8 border border-white/20">
            <div class="flex items-center gap-4 mb-6">
                <div class="bg-blue-600 rounded-full p-3">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-3xl font-bold text-white">Panel de Administración</h1>
                    <p class="text-blue-200">Bienvenido, <strong>{{username}}</strong></p>
                </div>
            </div>

            <p class="text-gray-300 mb-6">Desde aquí tienes control total del Simulador SisInfo.</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                <a href="/admin/users" class="bg-blue-600 hover:bg-blue-700 text-white rounded-xl p-5 transition transform hover:scale-[1.02] shadow-lg">
                    <div class="flex items-center gap-3">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                        <span class="font-semibold">Gestionar Usuarios</span>
                    </div>
                </a>
                <a href="/professor/create" class="bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl p-5 transition transform hover:scale-[1.02] shadow-lg">
                    <div class="flex items-center gap-3">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21v-2a4 4 0 00-4-4H9a4 4 0 00-4 4v2m8-10a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                        <span class="font-semibold">Registrar Profesor</span>
                    </div>
                </a>
                <a href="/coursed/create" class="bg-violet-600 hover:bg-violet-700 text-white rounded-xl p-5 transition transform hover:scale-[1.02] shadow-lg">
                    <div class="flex items-center gap-3">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        </svg>
                        <span class="font-semibold">Nueva Materia</span>
                    </div>
                </a>
                <a href="/user/new" class="bg-amber-600 hover:bg-amber-700 text-white rounded-xl p-5 transition transform hover:scale-[1.02] shadow-lg">
                    <div class="flex items-center gap-3">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                        </svg>
                        <span class="font-semibold">Crear Usuario</span>
                    </div>
                </a>
            </div>

            <div class="text-center">
                <a href="/logout" class="inline-block bg-red-600 hover:bg-red-700 text-white py-2 px-6 rounded-lg transition font-medium">
                    Cerrar Sesión
                </a>
            </div>
        </div>
    </div>

    <div class="fixed bottom-4 right-4 opacity-70 hover:opacity-100 transition-opacity">
        <img src="/images/logo_unrc.png" alt="UNRC" class="w-16 h-16 drop-shadow-lg">
    </div>
</body>
</html>