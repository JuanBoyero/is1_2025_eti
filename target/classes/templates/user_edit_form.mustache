<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Usuario - SisInfo</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Editar Usuario</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        {{#user}}
        <form action="/admin/users/{{id}}/edit" method="post" class="space-y-4">
            <div>
                <label for="name" class="block text-gray-700 text-sm font-medium mb-1">Nombre de Usuario:</label>
                <input type="text" id="name" name="name" value="{{name}}" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label for="password" class="block text-gray-700 text-sm font-medium mb-1">Contraseña (dejar en blanco para mantener la actual):</label>
                <input type="password" id="password" name="password"
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label for="role" class="block text-gray-700 text-sm font-medium mb-1">Rol:</label>
                <select name="role" id="role" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="STUDENT" {{#selectedSTUDENT}}selected{{/selectedSTUDENT}}>Alumno</option>
                    <option value="PROFESSOR" {{#selectedPROFESSOR}}selected{{/selectedPROFESSOR}}>Profesor</option>
                    <option value="ADMIN" {{#selectedADMIN}}selected{{/selectedADMIN}}>Administrador</option>
                </select>
            </div>
            <button type="submit"
                    class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                Guardar Cambios
            </button>
            <div class="text-center mt-4">
                <a href="/admin/users" class="text-blue-600 hover:underline text-sm">Volver al listado de usuarios</a>
            </div>
        </form>
        {{/user}}
    </div>
</body>
</html>
