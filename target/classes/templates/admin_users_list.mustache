<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Gestionar Usuarios - Administrador</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">
    <div class="max-w-5xl mx-auto bg-white p-6 rounded-lg shadow-lg">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Gestionar Usuarios</h1>
        <p class="text-gray-600 mb-6">Administrador: <strong>{{username}}</strong></p>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <div class="mb-4">
            <a href="/user/new"
               class="inline-block bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500">
                + Añadir Nuevo Usuario
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full border-collapse border border-gray-300">
                <thead>
                    <tr class="bg-gray-200">
                        <th class="border border-gray-300 px-4 py-2 text-left text-sm font-semibold text-gray-700">ID</th>
                        <th class="border border-gray-300 px-4 py-2 text-left text-sm font-semibold text-gray-700">Nombre</th>
                        <th class="border border-gray-300 px-4 py-2 text-left text-sm font-semibold text-gray-700">Rol</th>
                        <th class="border border-gray-300 px-4 py-2 text-center text-sm font-semibold text-gray-700">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {{#users}}
                    <tr class="hover:bg-gray-50">
                        <td class="border border-gray-300 px-4 py-2 text-sm text-gray-700">{{id}}</td>
                        <td class="border border-gray-300 px-4 py-2 text-sm text-gray-700">{{name}}</td>
                        <td class="border border-gray-300 px-4 py-2 text-sm">
                            {{#isAdmin}}<span class="inline-block px-2 py-1 text-xs font-semibold rounded bg-red-100 text-red-700">ADMIN</span>{{/isAdmin}}
                            {{#isProfessor}}<span class="inline-block px-2 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-700">PROFESSOR</span>{{/isProfessor}}
                            {{#isStudent}}<span class="inline-block px-2 py-1 text-xs font-semibold rounded bg-green-100 text-green-700">STUDENT</span>{{/isStudent}}
                        </td>
                        <td class="border border-gray-300 px-4 py-2 text-center">
                            <a href="/admin/users/edit/{{id}}"
                               class="inline-block bg-blue-500 text-white text-xs py-1 px-3 rounded hover:bg-blue-600 mr-1">
                                Editar
                            </a>
                            {{^isSelf}}
                            <form action="/admin/users/delete/{{id}}" method="post" class="inline"
                                  onsubmit="return confirm('¿Estás seguro de eliminar al usuario \"{{name}}\"?')">
                                <button type="submit"
                                        class="bg-red-500 text-white text-xs py-1 px-3 rounded hover:bg-red-600">
                                    Eliminar
                                </button>
                            </form>
                            {{/isSelf}}
                            {{#isSelf}}
                            <span class="text-xs text-gray-400 italic">(tú)</span>
                            {{/isSelf}}
                        </td>
                    </tr>
                    {{/users}}
                    {{^users}}
                    <tr>
                        <td colspan="4" class="border border-gray-300 px-4 py-4 text-center text-gray-500">
                            No hay usuarios registrados.
                        </td>
                    </tr>
                    {{/users}}
                </tbody>
            </table>
        </div>

        <div class="mt-6">
            <a href="/admin/dashboard" class="text-blue-600 hover:underline text-sm">Volver al panel</a>
        </div>
    </div>
</body>
</html>