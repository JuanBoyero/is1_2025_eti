<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Docente - SisInfo</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">
    <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Portal Docente</h1>
        <p class="text-xl text-gray-600 mb-8">Hola, <span class="font-semibold text-blue-600">{{username}}</span> 🎓</p>

        {{#professorName}}
        <div class="bg-white p-6 rounded-lg shadow-md mb-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Mis Datos</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-gray-700">
                <div>
                    <span class="font-semibold">Nombre:</span> {{professorName}} {{professorSurname}}
                </div>
                <div>
                    <span class="font-semibold">Email:</span> {{professorEmail}}
                </div>
                <div>
                    <span class="font-semibold">DNI:</span> {{professorDni}}
                </div>
            </div>
        </div>
        {{/professorName}}
        {{^professorName}}
        <div class="bg-yellow-50 border border-yellow-200 p-4 rounded-lg mb-8">
            <p class="text-yellow-800">No has completado tu registro como docente. <a href="/professor/create" class="underline font-semibold">Completar registro</a></p>
        </div>
        {{/professorName}}

        <div class="bg-white p-6 rounded-lg shadow-md mb-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Mis Materias Asignadas</h2>
            {{#courses}}
            <div class="flex justify-between items-center p-3 border-b border-gray-100 last:border-b-0">
                <span class="text-gray-700">{{name}}</span>
                <span class="text-sm text-gray-500">{{courseLoad}}h</span>
            </div>
            {{/courses}}
            {{^courses}}
            <p class="text-gray-500">No tienes materias asignadas actualmente.</p>
            {{/courses}}
        </div>

        <div class="text-center">
            <a href="/logout" class="inline-block bg-red-600 text-white py-2 px-6 rounded-md hover:bg-red-700 transition">Cerrar Sesión</a>
        </div>
    </div>
</body>
</html>
